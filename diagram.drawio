<mxfile host="app.diagrams.net">
  <diagram name="sino" id="cg-binary-flow">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="request" parent="1" value="User request:&lt;br&gt;&amp;quot;Update server 2&amp;#39;s OS&amp;quot;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1">
          <mxGeometry x="330" y="40" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="agent" parent="1" value="Agent proposes a shell command:&lt;br&gt;&amp;quot;sudo apt update&amp;quot;&lt;br&gt;&amp;quot;sudo apt upgrade&amp;quot;&lt;br&gt;&amp;quot;rm -rf /&amp;quot;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1">
          <mxGeometry x="300" y="160" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e1" parent="1" source="request" target="agent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="guard" parent="1" value="sino plugin&lt;br&gt;permission.evaluate&lt;br&gt;&lt;br&gt;1. sanitize: strip comments/heredocs,&lt;br&gt;   split segments, track cwd&lt;br&gt;2. tripwire? deny without the model&lt;br&gt;3. judge: binary allow / deny" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d80073;fontColor=#ffffff;strokeColor=#A50040;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="270" y="290" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e2" parent="1" source="agent" target="guard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="model" parent="1" value="GPT-6-Luna Decisions&lt;br&gt;POST /v1/decisions&lt;br&gt;&lt;br&gt;Allow  |  Deny&lt;br&gt;+ reason + probability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="700" y="290" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e3" parent="1" source="guard" target="model" value="trusted request + sanitized command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;labelBackgroundColor=#ffffff;" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="allow" parent="1" value="ALLOW&lt;br&gt;command runs in zsh" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#60a917;fontColor=#ffffff;strokeColor=#2D7600;" vertex="1">
          <mxGeometry x="150" y="490" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="deny" parent="1" value="DENY&lt;br&gt;permission.rejected&lt;br&gt;reason + &amp;quot;ask the user&lt;br&gt;to approve it, then retry&amp;quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a20025;fontColor=#ffffff;strokeColor=#6F0000;" vertex="1">
          <mxGeometry x="430" y="490" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e4" parent="1" source="guard" target="allow" value="Allow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;labelBackgroundColor=#ffffff;" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" parent="1" source="guard" target="deny" value="Deny / tripwire / fail closed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;labelBackgroundColor=#ffffff;" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ask" parent="1" value="Agent asks the user in its own words" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;" vertex="1">
          <mxGeometry x="700" y="500" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e6" parent="1" source="deny" target="ask" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" parent="1" source="ask" target="request" value="user approval = new request&lt;br&gt;(cache resets, re-judged)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="535" />
              <mxPoint x="980" y="70" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note" parent="1" value="Verdicts are cached per user request, so the same command is not re-judged inside one task.&lt;br&gt;Fail closed: timeout, error, or unparseable answer denies. Internal guard errors deny that command only." style="text;html=1;whiteSpace=wrap;align=left;" vertex="1">
          <mxGeometry x="60" y="630" width="700" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
